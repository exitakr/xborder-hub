# Supabase
# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local to git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (used by route handlers / server components when elevated access is required).
# Keep this secret. Do NOT prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
