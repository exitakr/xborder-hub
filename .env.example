# Supabase
# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local to git.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (used by route handlers / server components when elevated access is required).
# Keep this secret. Do NOT prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email — see PRELAUNCH.md for domain/DNS setup)
RESEND_API_KEY=
# Address that receives a notification email for every /legal/contact
# submission. Must actually be able to receive mail (mailbox or forward set
# up at your domain host) — Resend itself is send-only.
CONTACT_NOTIFY_EMAIL=contact@xbordercareer.com
