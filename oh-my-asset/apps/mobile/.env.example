# Copy to apps/mobile/.env and fill in. Never commit .env.
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle and are therefore
# NOT secret. Only the Supabase anon key belongs here — it is safe to ship
# because every query it makes is constrained by row-level security.
# The service-role key must never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web app origin, used for the Terms and Privacy links on the Legal screen.
EXPO_PUBLIC_SITE_URL=https://your-domain.example
