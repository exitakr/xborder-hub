# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used ONLY by the price cron.
# In Vercel, tick "Sensitive" when saving this value.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# eBay Developer Program — https://developer.ebay.com
# Production keyset. Browse API only; no restricted scopes are requested.
# Leave blank to run without automatic prices (curated prices still work).
# ---------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Pokémon TCG API — https://dev.pokemontcg.io
# Optional but strongly recommended: without a key the daily quota is low
# enough that a catalogue of any size will start hitting 429s.
# Scryfall (Magic cards) needs no key at all.
# ---------------------------------------------------------------------------
POKEMONTCG_API_KEY=

# ---------------------------------------------------------------------------
# Rakuten Web Service — https://webservice.rakuten.co.jp
# Free application ID, issued immediately on registration. Covers watches, bags
# and sneakers with JPY-native listing prices, which is the closest free source
# to the Japanese market for those categories. Leave blank to skip them.
# Attribution to Rakuten Web Service is required wherever the data is shown;
# `sourceLabel` in @oma/core carries the wording.
# ---------------------------------------------------------------------------
RAKUTEN_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Cron — protects /api/cron/refresh-prices. Generate with: openssl rand -hex 32
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com
#
# Leave all three blank and /plan shows "payments are not live yet" instead of
# a button. That is the intended state until an account exists; there is no
# half-configured mode in between.
#
# STRIPE_PRICE_ID is a one-time price created in the dashboard (Products → add
# a ¥100 one-off price). The amount lives THERE and never in this codebase, so
# no request from a browser can influence what something costs.
#
# STRIPE_WEBHOOK_SECRET comes from Developers → Webhooks after adding an
# endpoint at https://<your-domain>/api/stripe/webhook subscribed to
# checkout.session.completed, charge.refunded and charge.dispute.created.
# Without it the endpoint verifies nothing and therefore grants nothing.
#
# Mark the secret key and the webhook secret "Sensitive" in Vercel.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Seller identity — 特定商取引法に基づく表記 (/legal/commerce)
#
# Article 11 of Japan's Specified Commercial Transactions Act requires a seller
# to publish these before taking money from a consumer, and Stripe checks for
# the page when reviewing a Japanese account. They are NOT in the repository
# because they are a real person's legal name, postal address and telephone
# number.
#
# /legal/commerce returns 404 until SELLER_NAME is set, and the links to it
# appear only once it exists — so a half-filled notice can never go live.
#
# SELLER_DISCLOSE_ON_REQUEST=1 uses the 2021 amendment: the address and phone
# number may be withheld from the page provided it states they are disclosed
# without delay on request, and gives a way to ask. That is an alternative to
# publishing them, not to having them.
# ---------------------------------------------------------------------------
SELLER_NAME=
SELLER_MANAGER=
SELLER_ADDRESS=
SELLER_PHONE=
SELLER_DISCLOSE_ON_REQUEST=

# ---------------------------------------------------------------------------
# Canonical origin
# ---------------------------------------------------------------------------
# Used for OAuth redirects, canonical tags, Open Graph URLs and the sitemap.
# Effectively required in production: without it the deployment falls back to
# its Vercel hostname, and a site that publishes the wrong origin is a site
# search engines index under a URL you do not own.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Shown on legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
# FX source. Defaults to open.er-api.com (free, no key, JPY base).
FX_RATES_URL=
