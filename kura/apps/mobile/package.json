{
  "name": "@kura/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "//versions": "Native module versions come from expo/bundledNativeModules.json for SDK 57 — the same source `expo install` uses. Do not bump them by hand; run `npx expo install --fix` after an SDK upgrade.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all",
    "prebuild": "expo prebuild --clean",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@kura/core": "*",
    "@supabase/supabase-js": "^2.46.1",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^5.7.2"
  }
}
