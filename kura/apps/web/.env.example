# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used ONLY by the price cron.
# In Vercel, tick "Sensitive" when saving this value.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# eBay Developer Program — https://developer.ebay.com
# Production keyset. Browse API only; no restricted scopes are requested.
# Leave blank to run without automatic prices (curated prices still work).
# ---------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Pokémon TCG API — https://dev.pokemontcg.io
# Optional but strongly recommended: without a key the daily quota is low
# enough that a catalogue of any size will start hitting 429s.
# Scryfall (Magic cards) needs no key at all.
# ---------------------------------------------------------------------------
POKEMONTCG_API_KEY=

# ---------------------------------------------------------------------------
# Rakuten Web Service — https://webservice.rakuten.co.jp
# Free application ID, issued immediately on registration. Covers watches, bags
# and sneakers with JPY-native listing prices, which is the closest free source
# to the Japanese market for those categories. Leave blank to skip them.
# Attribution to Rakuten Web Service is required wherever the data is shown;
# `sourceLabel` in @kura/core carries the wording.
# ---------------------------------------------------------------------------
RAKUTEN_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Cron — protects /api/cron/refresh-prices. Generate with: openssl rand -hex 32
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Canonical origin, used for OAuth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
# FX source. Defaults to open.er-api.com (free, no key, JPY base).
FX_RATES_URL=
